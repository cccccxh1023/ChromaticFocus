+    private var localizedStatusText: String {
+        switch model.runState {
+        case .idle:
+            return tr("Ready", "准备就绪")
+        case .starting:
+            return tr("Starting screen capture…", "正在启动屏幕捕获…")
+        case .running:
+            return tr(
+                "Red-in-focus filter is active",
+                "Red-in-Focus 滤镜已启用"
+            )
+        case .failed(let message):
+            return localizedError(message)
+        }
+    }
+
+    private func localizedError(_ message: String) -> String {
+        let exact: [String: String] = [
+            "Display configuration changed; the filter was safely closed.": tr(
+                "The display configuration changed, so the filter was safely closed.",
+                "显示器配置发生变化，滤镜已安全关闭。"
+            ),
+            "Screen Recording permission is required.": tr(
+                "Screen Recording permission is required.",
+                "需要授予屏幕录制权限。"
+            ),
+            "Display geometry is incomplete. Check the screen-width setting.": tr(
+                "Display geometry is incomplete. Check the screen-width setting.",
+                "显示器几何参数不完整，请检查屏幕宽度设置。"
+            ),
+            "Screen Recording permission was not granted.": tr(
+                "Screen Recording permission was not granted.",
+                "未授予屏幕录制权限。"
+            ),
+            "No screen frame arrived. After granting permission, macOS may require the app to be relaunched.": tr(
+                "No screen frame arrived. After granting permission, macOS may require the app to be relaunched.",
+                "没有收到屏幕画面。授予权限后，macOS 可能要求重新启动此 App。"
+            ),
+            "The selected display is no longer available.": tr(
+                "The selected display is no longer available.",
+                "所选显示器已不可用。"
+            ),
+            "Metal is unavailable on this Mac.": tr(
+                "Metal is unavailable on this Mac.",
+                "此 Mac 无法使用 Metal。"
+            ),
+            "The display renderer could not obtain a drawable; the filter was safely closed.": tr(
+                "The display renderer could not obtain a drawable, so the filter was safely closed.",
+                "显示渲染器无法取得可绘制画面，滤镜已安全关闭。"
+            )
+        ]
+
+        if let translated = exact[message] {
+            return translated
+        }
+
+        let startPrefix = "Could not start: "
+        if message.hasPrefix(startPrefix) {
+            let detail = String(message.dropFirst(startPrefix.count))
+            return tr("Could not start:", "无法启动：") + " " + localizedDetail(detail)
+        }
+
+        let capturePrefix = "Screen capture stopped: "
+        if message.hasPrefix(capturePrefix) {
+            let detail = String(message.dropFirst(capturePrefix.count))
+            return tr("Screen capture stopped:", "屏幕捕获已停止：") + " " + localizedDetail(detail)
+        }
+
+        let gpuPrefix = "GPU rendering failed ("
+        let gpuSuffix = "); the filter was safely closed."
+        if message.hasPrefix(gpuPrefix), message.hasSuffix(gpuSuffix) {
+            let start = message.index(message.startIndex, offsetBy: gpuPrefix.count)
+            let end = message.index(message.endIndex, offsetBy: -gpuSuffix.count)
+            let detail = String(message[start..<end])
+            return language.resolved == .simplifiedChinese
+                ? "GPU 渲染失败（\(localizedDetail(detail))），滤镜已安全关闭。"
+                : "GPU rendering failed (\(localizedDetail(detail))); the filter was safely closed."
+        }
+
+        return message
+    }
+
+    private func localizedDetail(_ detail: String) -> String {
+        switch detail {
+        case "The selected display is no longer available.":
+            return tr(
+                "The selected display is no longer available.",
+                "所选显示器已不可用。"
+            )
+        case "Metal is unavailable on this Mac.":
+            return tr(
+                "Metal is unavailable on this Mac.",
+                "此 Mac 无法使用 Metal。"
+            )
+        default:
+            return detail
+        }
+    }
